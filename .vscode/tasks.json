{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build test",
            "type": "shell",
            "command": "make build_${input:testName}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"]
        }
    ],
    "inputs": [
        {
            "id": "testName",
            "type": "promptString",
            "description": "Name der Testdatei ohne .c (z.B. field, box, intfield)",
            "default": "field"
        }
    ]
}
